NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Create this database before running migrations.
DB_DIALECT=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false

# Set a unique random value of at least 32 characters before starting the API.
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=10
MAX_UPLOAD_MB=100

# Used only by `npm run admin:create`; never committed.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
